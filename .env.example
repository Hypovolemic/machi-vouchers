# Machi Vouchers configuration. Copy to .env.local (git-ignored) for local runs; set the same
# names in the Vercel project for the hosted demo. None of these may use the NEXT_PUBLIC_ prefix:
# every value is read on the server only.

# Sui testnet RPC (optional; this is the default)
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Public IDs from `npm run setup:testnet` (also listed in docs/testnet-deployment.md)
MV_PACKAGE_ID=
MV_PROGRAM_ID=
MV_LOCAL_POLICY_ID=
MV_ANY_POLICY_ID=
MV_ISSUER_CAP_ID=
MV_DJPY_CAP_ID=

# SECRETS: testnet-only demo keys written by the setup script. Never commit, never reuse on mainnet.
# The issuer can mint demo yen and issue purchase tickets; Yuki signs payments; shops sign stamps.
MV_ISSUER_KEY=
MV_RESIDENT_KEY=
MV_SHOP_KEYS=
# Used only by the setup script (the city's deposit); not needed by the hosted app.
MV_FUNDER_KEY=

# Wallet passes (optional). SECRET: PassEntry API key from the PassEntry dashboard.
PASSENTRY_API_KEY=
PASSENTRY_TEMPLATE_ID=
